# Platform-level keys — used for build-time platform operations (manifesto
# expansion) and as the default/shared key for capabilities that support it.
# Individual agents can still bring their own key via the wizard; these are
# just what the platform itself falls back to.

# Required to expand a manifesto into a system prompt (always runs on Groq
# regardless of the agent's own chosen model provider).
GROQ_API_KEY=

# WolframAlpha capability: shared platform key pool (up to 3), used when an
# agent doesn't supply its own. Free — sign up at developer.wolframalpha.com/access.
WOLFRAM_ALPHA_APP_ID=
WOLFRAM_ALPHA_APP_ID_2=
WOLFRAM_ALPHA_APP_ID_3=

# Web Search & Scrape capability (Firecrawl), used as the shared platform key
# when an agent doesn't supply its own via the wizard. Sign up at
# firecrawl.dev to get a key.
FIRECRAWL_API_KEY=


# GitHub capability (part of the dev_pack MCP container). No per-agent BYOK
# for this one either. Needs at least `repo` scope for most useful actions.
GITHUB_PERSONAL_ACCESS_TOKEN=

# Featherless AI — serverless GPU inference for open-source models.
# Each agent can supply their own key via the wizard; this is the platform fallback.
# Sign up at featherless.ai to get an API key.
FEATHERLESS_API_KEY=

# Google Cloud Run deployment (set DEPLOY_MODE=cloudrun to use)
GCP_PROJECT_ID=
GCP_REGION=us-central1
GCP_ARTIFACT_REPO=forge
DEPLOY_MODE=local

# --- Google account connections (optional) ------------------------------
# Lets agents with the Calendar / Gmail / Google Sheets capabilities act on a
# real Google account. Create an OAuth 2.0 Client ID (type: Web application)
# in a Google Cloud project, enable the APIs you want, and register this exact
# redirect URI on the client:
#
#     http://localhost:8000/api/oauth/google/callback
#
# Enable the APIs for whichever capabilities you plan to offer:
#   Calendar          -> Google Calendar API
#   Google Sheets     -> Google Sheets API
#   Google Docs       -> Google Docs API
#   Google Slides     -> Google Slides API
#   Google Drive      -> Google Drive API
#   Google Classroom  -> Google Classroom API
#   Gmail             -> Gmail API   (see the warning below)
#
# While the OAuth app is in "Testing" it works immediately for accounts you add
# as test users (up to 100), with an "unverified app" interstitial. Publishing
# needs Google verification.
#
# Scope tiers decide how painful that verification is, so choose deliberately:
# Calendar/Docs/Slides/Sheets/Classroom-readonly are "sensitive" — brand review
# only. Gmail's scopes and full Drive access are "restricted" and additionally
# require an annual third-party security assessment (CASA). Drive is requested
# here as drive.file precisely to stay out of that tier.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Where Google should send users back to. Change only if the backend isn't on
# localhost:8000; it must match the registered redirect URI's origin.
PUBLIC_BACKEND_URL=http://localhost:8000
# Signs the short-lived state token that ties a callback to its agent.
OAUTH_STATE_SECRET=
